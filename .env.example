# Copy this file to .env and fill in the values. Never commit .env.
# Gemini, Anthropic or OpenAI key. The config page verifies it and writes AI_PROVIDER for you;
# when editing by hand also set AI_PROVIDER=gemini|anthropic|openai (otherwise the prefix is used).
AI_API_KEY=
AI_PROVIDER=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=StremioAITranslator v1.0
TARGET_LANGUAGE=he
PORT=7000
LOG_LEVEL=info

# Optional tuning (defaults shown)
CHUNK_SIZE=30
CHUNK_CONCURRENCY=2
# Minimum pause between AI requests (ms). Keeps free-tier keys under their per-minute limit.
CHUNK_DELAY_MS=4000
CHUNK_MAX_RETRIES=2
GEMINI_TIMEOUT_MS=120000
# Unicode RLM marks keep punctuation on the correct side for Hebrew/Arabic. On by default;
# set to false only if you want to turn it off.
RTL_FIX=true
# Log dialogue text (only effective with LOG_LEVEL=debug)
LOG_DIALOGUE=false

# Cache and Stremio behaviour (defaults shown)
CACHE_TTL_DAYS=90
# How long a subtitle request waits for a running translation before showing "in progress"
SUB_WAIT_MS=15000
MAX_CONCURRENT_JOBS=2
# Extra browser origins allowed to call the add-on routes (comma separated), normally empty
STREMIO_ALLOWED_ORIGINS=
