# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=StremioAITranslator v1.0
TARGET_LANGUAGE=he
PORT=7000
LOG_LEVEL=info

# Optional tuning (defaults shown)
CHUNK_SIZE=60
CHUNK_CONCURRENCY=2
CHUNK_MAX_RETRIES=2
GEMINI_TIMEOUT_MS=90000
# Add Unicode RLM marks to RTL languages. Enable ONLY if punctuation looks wrong in Stremio.
RTL_FIX=false
# Log dialogue text (only effective with LOG_LEVEL=debug)
LOG_DIALOGUE=false
