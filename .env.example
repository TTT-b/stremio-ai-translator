# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=StremioAITranslator v1.0
TARGET_LANGUAGE=he
PORT=7000
LOG_LEVEL=info

# Optional tuning (defaults shown)
CHUNK_SIZE=30
CHUNK_CONCURRENCY=3
CHUNK_MAX_RETRIES=2
GEMINI_TIMEOUT_MS=120000
# Add Unicode RLM marks to RTL languages. Enable ONLY if punctuation looks wrong in Stremio.
RTL_FIX=false
# Log dialogue text (only effective with LOG_LEVEL=debug)
LOG_DIALOGUE=false

# Cache and Stremio behaviour (defaults shown)
CACHE_TTL_DAYS=90
# How long a subtitle request waits for a running translation before showing "in progress"
SUB_WAIT_MS=15000
MAX_CONCURRENT_JOBS=2
# Extra browser origins allowed to call the add-on routes (comma separated), normally empty
STREMIO_ALLOWED_ORIGINS=
