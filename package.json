{
  "name": "stremio-ai-subtitle-translator",
  "version": "1.7.0",
  "private": true,
  "license": "MIT",
  "description": "Local Stremio add-on that translates subtitles with Gemini",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/web/tailwind.input.css -o src/web/tailwind.generated.css --minify",
    "prestart": "npm run build:css",
    "predev": "npm run build:css",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "cross-env LIVE_TEST=1 vitest run tests/live",
    "cache:cleanup": "tsx src/cli/cacheCleanup.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "build:desktop": "node scripts/build-electron.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --win nsis",
    "publish": "npm run build:desktop && node --env-file=.env node_modules/electron-builder/cli.js --win nsis -p always",
    "icon": "node scripts/make-icon.mjs",
    "news": "tsx scripts/post-news.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@google/genai": "^2.29.1",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "chardet": "^2.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "express": "^4.22.3",
    "iconv-lite": "^0.7.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "stremio-addon-sdk": "^1.6.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "main": "dist-electron/main.cjs",
  "author": "Stremio AI Subtitle Translator",
  "build": {
    "appId": "local.stremio-ai-subtitle-translator",
    "productName": "Stremio AI Subtitle Translator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/*.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Stremio-AI-Subtitle-Translator-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "icon": "build/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "TTT-b",
        "repo": "stremio-ai-translator"
      }
    ]
  }
}
